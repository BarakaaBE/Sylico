{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.sylico.be" }],
      "destination": "https://sylico.be/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "sylico.vercel.app" }],
      "destination": "https://sylico.be/$1",
      "permanent": true
    }
  ]
}
